{
  // Type checking only (npm run check); esbuild does the building.
  // Loose for now: the code came from plain JavaScript, and types get tightened module by module.
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["app/src", "test", "vitest.config.ts"]
}
